        <Button Content="Удалить" HorizontalAlignment="Left" Margin="420,404,0,0" VerticalAlignment="Top" Width="200"/>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="630,404,0,0" VerticalAlignment="Top" Width="160"/>
        <TextBox HorizontalAlignment="Left" Margin="10,381,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="405"/>
        <TextBox HorizontalAlignment="Left" Margin="420,381,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="370"/>
        <Label Content="Название" HorizontalAlignment="Left" Margin="10,355,0,0" VerticalAlignment="Top"/>
        <Label Content="Адрес" HorizontalAlignment="Left" Margin="420,355,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
