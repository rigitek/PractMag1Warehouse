<Window x:Class="PractMag1Warehouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PractMag1Warehouse"
        mc:Ignorable="d"
        Title="MainWindow" Height="360" Width="271">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Margin="5">

            <TextBlock Text="Добро пожаловать!" FontSize="16" TextAlignment="Center"/>
            <TextBlock x:Name="Employee" FontSize="16" TextAlignment="Center"/>
            <Button x:Name="WarehouseButton" Content="Склады" Margin="5" Click="Warehouse_Click"/>
            <Button x:Name="EmployeeButton" Content="Сотрудники"   Margin="5" Click="Employee_Click"/>
            <Button x:Name="ToolButton" Content="Оборудование" Margin="5" Click="Tool_Click"/>

        </StackPanel>
    </Grid>
</Window>
